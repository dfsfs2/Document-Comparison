# Local development. Choose different secrets for shared deployments.
MYSQL_DATABASE=doc_compare
MYSQL_USER=doc_compare
MYSQL_PASSWORD=doccompare_local_password
MYSQL_ROOT_PASSWORD=doccompare_local_root_password
AGENT_TOKEN=doccompare_local_agent_token
APP_PORT=8088

# Paste the key into your own .env or export DASHSCOPE_API_KEY in your shell.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
